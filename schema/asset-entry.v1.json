{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zjashanda/ark-kb/schema/asset-entry.v1.json",
  "title": "ark.tts-asset-entry.v1",
  "description": "TTS 音频库的可搜索索引条目。只登记 asset ID、缓存键、SHA、作用域、受控相对位置与摘要，不存音频本体、不存文本全文。真源在 asset-tools 的 tts-library，本条目只是索引。",
  "type": "object",
  "required": [
    "schema",
    "asset_id",
    "cache_key",
    "audio_sha256",
    "quality",
    "status",
    "scope",
    "language",
    "voice",
    "engine",
    "library_path",
    "created_at",
    "updated_at",
    "summary",
    "superseded_by"
  ],
  "properties": {
    "schema": { "const": "ark.tts-asset-entry.v1" },
    "asset_id": {
      "type": "string",
      "pattern": "^tts-[0-9a-f]{16}(-v[0-9]+)?$",
      "description": "asset-tools 发布的资产 ID；版本化副本形如 tts-<key16>-v2。"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "完整缓存键 sha256；精确命中唯一权威。"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "音频内容哈希；调用方取件后必须自行复核。"
    },
    "quality": { "enum": ["formal", "candidate", "evidence_gap"] },
    "status": { "enum": ["active", "stale", "superseded"] },
    "scope": { "$ref": "#/$defs/scope" },
    "language": { "type": "string", "minLength": 1 },
    "voice": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "library_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?![A-Za-z]:)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "description": "相对 1006 库根的受控路径，禁止绝对路径与 .. 逃逸；调用方不得据此裸拼。"
    },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "summary": {
      "type": "string",
      "maxLength": 300,
      "description": "脱敏短摘要，只由元数据拼装，不得复制文本全文。"
    },
    "superseded_by": { "type": ["string", "null"] },
    "hits": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["visibility"],
      "properties": {
        "visibility": { "enum": ["public", "project", "restricted"] },
        "projects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nodes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
