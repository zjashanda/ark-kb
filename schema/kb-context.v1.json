{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zjashanda/ark-kb/schema/kb-context.v1.json",
  "title": "ark.kb-context.v1",
  "description": "任务开工前的知识查询留痕。写到 plan.md 的「知识查询」段（人读）与 run.receipt.json 的 kb_context 字段（机读）；空结果记 no_hit=true，不是错误。",
  "type": "object",
  "required": [
    "schema",
    "contract_version",
    "queried_at",
    "dims",
    "registry_commit",
    "hits",
    "no_hit",
    "refresh_points",
    "refresh_log"
  ],
  "properties": {
    "schema": { "const": "ark.kb-context.v1" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "queried_at": { "$ref": "#/$defs/timestamp" },
    "dims": { "$ref": "#/$defs/dims" },
    "registry_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|unknown)$",
      "description": "知识库提交号；取不到时写 unknown，不伪造"
    },
    "hits": {
      "type": "array",
      "items": { "$ref": "#/$defs/hit" }
    },
    "no_hit": { "type": "boolean" },
    "refresh_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/refresh_point" }
    },
    "refresh_log": {
      "type": "array",
      "items": { "$ref": "#/$defs/refresh_log" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
      "description": "北京时间，空格分隔，秒精度，不带时区标记"
    },
    "dims": {
      "type": "object",
      "required": ["capability", "project", "device", "firmware", "profile", "skill"],
      "properties": {
        "capability": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "device": { "type": ["string", "null"] },
        "firmware": { "type": ["string", "null"] },
        "profile": { "type": "string" },
        "skill": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hit": {
      "type": "object",
      "required": ["id", "type", "status", "confidence", "score", "commit", "source_skill"],
      "properties": {
        "id": { "type": "string", "pattern": "^kb-(knowledge|method|run|bug)-[0-9a-f]{12}$" },
        "type": { "enum": ["knowledge", "method", "run", "bug"] },
        "status": { "enum": ["pending", "active", "stale", "superseded"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "score": { "type": "integer", "minimum": 0 },
        "commit": { "type": "string" },
        "source_skill": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "refresh_point": {
      "type": "object",
      "required": ["at", "reason"],
      "properties": {
        "at": { "type": "string", "description": "刷新点标识，如 stage:2 或分钟/轮次边界" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "refresh_log": {
      "type": "object",
      "required": ["at", "reason", "registry_commit", "new_hit_ids"],
      "properties": {
        "at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string" },
        "registry_commit": { "type": "string" },
        "new_hit_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
